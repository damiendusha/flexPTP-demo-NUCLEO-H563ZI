[submodule "Modules/embfmt"]
	path = Modules/embfmt
	url = https://github.com/epagris/embfmt
[submodule "Modules/lwip"]
	path = Modules/lwip
	url = https://github.com/lwip-tcpip/lwip.git
[submodule "Modules/flexptp"]
	path = Modules/flexptp
	url = https://github.com/epagris/flexPTP
[submodule "Modules/etherlib"]
	path = Modules/etherlib
	url = https://gitea.epagris.com/epagris/EtherLib
[submodule "Drivers/stm32h5xx-hal-driver"]
	path = Drivers/stm32h5xx-hal-driver
	url = https://github.com/STMicroelectronics/stm32h5xx-hal-driver.git
[submodule "Modules/threadx"]
	path = Modules/threadx
	url = https://github.com/eclipse-threadx/threadx.git
[submodule "Modules/cmsis_rtos_threadx"]
	path = Modules/cmsis_rtos_threadx
