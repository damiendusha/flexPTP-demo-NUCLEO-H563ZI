load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Run under sh_test rather than py_test: the project needs no rules_python today (D2), and these
# tests import only the standard library. If rules_python arrives for another reason, this
# should become a py_test.
sh_test(
    name = "find_openocd_test",
    srcs = ["run_unittest.sh"],
    args = ["test_find_openocd"],
    data = [
        "hil.py",
        "test_find_openocd.py",
    ],
)

# The SWD inspection tool's parsers (heap_4 walk, FreeRTOS task lists, ThreadX thread blocks,
# exception frames), on synthetic target memory. See swd.py.
sh_test(
    name = "swd_test",
    srcs = ["run_unittest.sh"],
    args = ["test_swd"],
    data = [
        "hil.py",
        "swd.py",
        "test_swd.py",
    ],
)

# The scenario helpers that decide PASS/FAIL on the board, and the malformed-PTP packet builders.
sh_test(
    name = "scenarios_test",
    srcs = ["run_unittest.sh"],
    args = ["test_scenarios"],
    data = [
        "checks.py",
        "flood.py",
        "hil.py",
        "ptp_fuzz.py",
        "scenario.py",
        "scenarios.py",
        "test_scenarios.py",
    ],
)
