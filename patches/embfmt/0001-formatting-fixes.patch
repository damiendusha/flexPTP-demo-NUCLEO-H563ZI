+            while (!(d >= 1.0 && d < 10.0)) {
+                d *= q;
+                exponent += d_exp;
+            }
+        }
+    }
+
     // round to requested precision if trucation is not instructed
     if (fmt->type != DOUBLE_TRUNCATE) {
