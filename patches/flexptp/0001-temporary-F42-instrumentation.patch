+/* ---- TEMPORARY INSTRUMENTATION (F42). ----
+ * Counts what lwIP actually hands to the PTP network-stack driver. If byType[0x9]
+ * (Delay_Resp) stays zero while tcpdump shows the frame on the wire, the packet is being
+ * dropped inside lwIP/UDP and never reaches this callback at all. */
+volatile struct {
+    uint32_t cbCalls;    // ptp_receive_cb() invocations
+    uint32_t onEvent;    // ... on the event PCB (UDP 319)
+    uint32_t onGeneral;  // ... on the general PCB (UDP 320)
+    uint32_t onOther;    // ... on neither (should never happen)
+    uint32_t shortPkt;   // payload too short to contain a PTP header
+    uint32_t byType[16]; // indexed by the messageType nibble; Delay_Resp is 0x9
+} nsddbg = {0};
+
 static void ptp_receive_cb(void *pArg, struct udp_pcb *pPCB, struct pbuf *pP, const ip_addr_t *pAddr, uint16_t port) {
+    nsddbg.cbCalls++;
+    if (pPCB == PTP_L4_EVENT) {
+        nsddbg.onEvent++;
+    } else if (pPCB == PTP_L4_GENERAL) {
+        nsddbg.onGeneral++;
+    } else {
+        nsddbg.onOther++;
+    }
+    if (pP->len >= 34U) {
+        nsddbg.byType[((uint8_t *)pP->payload)[0] & 0x0FU]++;
+    } else {
+        nsddbg.shortPkt++;
+    }
+
     // put msg into the queue
     ptp_receive_enqueue(pP->payload, pP->len, pP->time_s, pP->time_ns, PTP_TP_IPv4);
 
