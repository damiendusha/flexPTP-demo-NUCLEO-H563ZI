# Code common to both firmwares.
#
# Phase 9 of the Bazel migration (D11): the two projects were kept deliberately independent
# while the second was brought up, and what is genuinely shared is factored out afterwards --
# against two real applications rather than against a guess about what one of them would need.
#
# This is tier 1 of the order in docs/bazel_migration.md §13.8: units that depend on nothing but
# stdint. They were extracted from the driver in the first place so they could be tested
# off-target, which is also what makes them the safest thing to unify -- the host suite already
# pins their behaviour, and //tools/ci:seeding_test had been asserting the two projects' copies
# were byte-identical, so there is nothing to reconcile.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

FIRST_PARTY = ["first_party_warnings"]

# The flexPTP network-stack-driver logic, lifted out of the NSD so it could be tested without a
# board, an RTOS or a network stack.
cc_library(
    name = "ptp_units",
    srcs = glob(["ptp/*.cpp"]),
    hdrs = glob(["ptp/*.h"]),
    features = FIRST_PARTY,
    includes = [
        ".",
        "ptp",
    ],
)

# The framing and link-state decisions lifted out of the Ethernet driver (TS-04, CX-06).
cc_library(
    name = "eth_framer",
    srcs = ["eth/eth_framer.cpp"],
    hdrs = ["eth/eth_framer.h"],
    features = FIRST_PARTY,
    includes = [
        ".",
        "eth",
    ],
)

cc_library(
    name = "eth_link_state",
    srcs = ["eth/eth_link_state.cpp"],
    hdrs = ["eth/eth_link_state.h"],
    features = FIRST_PARTY,
    includes = [
        ".",
        "eth",
    ],
)

# The bounds arithmetic _sbrk relies on. Header-only.
cc_library(
    name = "sysmem_bounds",
    hdrs = ["runtime/sysmem_bounds.h"],
    features = FIRST_PARTY,
    includes = ["runtime"],
)

# ---------------------------------------------------------------------------
# Tier 2 -- the hardware layer
# ---------------------------------------------------------------------------
#
# Same silicon, same registers, and mac_drv.h is stack-agnostic by design: it was written that
# way so the driver could outlive a change of network stack, which is exactly what happened.

# The console's INTERFACE. The implementation stays per-project for now, because it creates an
# RTOS thread and the two firmwares' CMSIS-RTOS2 wrappers are different objects -- that is tier
# 3. Sharing the header alone is enough for the driver: MSG() resolves at link time against
# whichever implementation the firmware links.
cc_library(
    name = "io_headers",
    hdrs = glob(["io/*.h"]),
    includes = ["."],
    strip_include_prefix = "io",
    include_prefix = "standard_output",
)

# The MAC driver, at the DMA descriptor level. Always built, in both firmwares: it owns the PTP
# clock registers the flexPTP hardware port reaches, which is why it stayed compiled even in the
# configurations that linked no network stack at all.
cc_library(
    name = "mac_drv",
    srcs = [
        "eth/mac_drv.c",
        "eth/phy_drv/phy_common.c",
    ],
    hdrs = [
        "eth/mac_drv.h",
        "eth/phy_drv/phy_common.h",
    ],
    features = FIRST_PARTY,
    includes = [
        ".",
        "eth",
    ],
    target_compatible_with = ["//toolchain:stm32h563"],
    deps = [
        ":io_headers",
        "@stm32h5_hal//:hal",
    ],
)

# mac_drv.c for TEXTUAL inclusion, which is how the host harness reaches its file statics.
cc_library(
    name = "mac_drv_textual",
    hdrs = [
        "eth/mac_drv.h",
        "eth/phy_drv/phy_common.h",
    ],
    includes = [
        ".",
        "eth",
    ],
    textual_hdrs = [
        "eth/mac_drv.c",
        "eth/phy_drv/phy_common.c",
    ],
    deps = [":io_headers"],
)

# flexPTP's STM32H563 hardware port. Sources rather than a library: it is compiled INTO flexPTP,
# which each project instantiates with its own configuration.
exports_files([
    "ptp/ptp_port_stm32h563.c",
    "ptp/ptp_port_stm32h563.h",
])

cc_library(
    name = "ptp_port_headers",
    hdrs = ["ptp/ptp_port_stm32h563.h"],
    includes = [
        ".",
        "ptp",
    ],
)

# ---------------------------------------------------------------------------
# Tier 3 -- the CMSIS-RTOS2 layer
# ---------------------------------------------------------------------------
#
# These are portable between the two firmwares for one reason, and it is the reason the monorepo
# is natural rather than forced: the project is CMSIS-RTOS2 throughout. cmsis_os2.h is ARM's and
# RTOS-agnostic, so this code compiles against the API and each firmware links its own
# implementation underneath -- ST's ThreadX-backed wrapper in one, its FreeRTOS-backed one in
# the other. Middlewares/CMakeLists.txt made exactly this observation when the kernel was
# swapped: "the application never called FreeRTOS in any quantity".
#
# Neither library names an RTOS. The osThreadNew() and osMutexAcquire() calls resolve at link
# against whichever wrapper the firmware pulls in.

# The FIFO source, for the host tests that compile it against a real kernel.
exports_files(["blocking_io/blocking_fifo.c"])

cc_library(
    name = "blocking_io",
    srcs = ["blocking_io/blocking_fifo.c"],
    hdrs = ["blocking_io/blocking_fifo.h"],
    features = FIRST_PARTY,
    includes = [
        ".",
        "blocking_io",
    ],
    target_compatible_with = ["//toolchain:stm32h563"],
    deps = ["//third_party/CMSIS:cmsis"],
)

# cli.c for TEXTUAL inclusion: the CLI test includes the .c verbatim to reach its file statics.
cc_library(
    name = "cli_textual",
    hdrs = ["cli/cli.h"],
    includes = [
        ".",
        "cli",
    ],
    textual_hdrs = ["cli/cli.c"],
    deps = [
        ":blocking_io_headers",
        ":io_headers",
    ],
)

cc_library(
    name = "blocking_io_headers",
    hdrs = ["blocking_io/blocking_fifo.h"],
    includes = [
        ".",
        "blocking_io",
    ],
)

cc_library(
    name = "cli",
    srcs = ["cli/cli.c"],
    hdrs = ["cli/cli.h"],
    features = FIRST_PARTY,
    includes = [
        ".",
        "cli",
    ],
    target_compatible_with = ["//toolchain:stm32h563"],
    deps = [
        ":blocking_io",
        ":io_headers",
        "//third_party/CMSIS:cmsis",
    ],
)

# The console. serial_io.c splits into a hardware half and an RTOS half deliberately -- see the
# note in main.c of either firmware: ThreadX's CMSIS-RTOS2 wrapper carves its byte pools inside
# osKernelInitialize(), so nothing can be allocated before it, and both firmwares now follow
# that order.
cc_library(
    name = "standard_output",
    srcs = [
        "io/serial_io.c",
        "io/standard_output.c",
    ],
    features = FIRST_PARTY,
    target_compatible_with = ["//toolchain:stm32h563"],
    deps = [
        ":blocking_io",
        ":io_headers",
        "//third_party/CMSIS:cmsis",
        "@embfmt",
        "@stm32h5_hal//:hal",
    ],
)

# ---------------------------------------------------------------------------
# Tier 4 -- the runtime, the reset vector and the memory map
# ---------------------------------------------------------------------------

# The HAL's configuration, and the device selection that goes with it.
#
# §13.8 listed this as a judgement call -- share it only if both firmwares genuinely want the
# same values. They do, byte for byte: same part, same HAL modules, same HAL_ETH_USE_PTP and
# ETH_RX_DESC_CNT. If one ever needs to differ, this goes back to being per-project behind the
# label_flag @stm32h5_hal//:hal_conf already provides.
cc_library(
    name = "hal_conf",
    hdrs = ["runtime/stm32h5xx_hal_conf.h"],
    defines = [
        "STM32H563xx",
        "USE_HAL_DRIVER",
    ],
    includes = ["runtime"],
    deps = ["//third_party/CMSIS:cmsis"],
)

# newlib's syscalls, the heap, the C++ runtime probe, and the clock tree.
#
# sysmem.c is the interesting one: _sbrk is bounded against the linker script's symbols so that
# exhaustion REPORTS AND HALTS rather than silently returning memory that overlaps the stack.
# cpp_support.cpp exists to make the C++ runtime observable on hardware -- the cpp_ctor check in
# tools/hil/ asks the running board whether static constructors ran.
cc_library(
    name = "runtime",
    srcs = [
        "runtime/cpp_support.cpp",
        "runtime/syscall.c",
        "runtime/sysmem.c",
        "runtime/system_stm32h5xx.c",
    ],
    features = FIRST_PARTY,
    target_compatible_with = ["//toolchain:stm32h563"],
    deps = [
        ":hal_conf",
        ":io_headers",
        ":sysmem_bounds",
        "@stm32h5_hal//:hal",
    ],
    alwayslink = True,
)

# The reset vector and the memory map. Both firmwares are the same part with the same layout;
# what differs is what the RTOS adds -- ThreadX contributes tx_initialize_low_level.S, which
# stays in that project because the clock, tick and end-of-RAM marker are its integrator's to
# supply.
cc_library(
    name = "startup",
    srcs = ["startup/startup_stm32h563zitx.s"],
    target_compatible_with = ["//toolchain:stm32h563"],
    deps = [":hal_conf"],
    alwayslink = True,
)

exports_files(["startup/stm32h563zitx_FLASH.ld"])
