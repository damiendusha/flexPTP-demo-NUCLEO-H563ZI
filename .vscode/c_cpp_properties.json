{
    "version": 4,
    "configurations": [
        {
            /**
             * Only used if C_Cpp.intelliSenseEngine is turned back on: settings.json disables it
             * in favour of clangd. Both read the same database, which
             * tools/ide/refresh_compile_commands.py writes (task "Bazel: refresh
             * compile_commands.json").
             */
            "name": "STM32",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "intelliSenseMode": "${default}"
        }
    ]
}
