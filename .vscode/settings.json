{
    "workbench.colorTheme": "CLion Plus Theme",
    "cortex-debug.variableUseNaturalFormat": true,
    "todohighlight.keywords": [
        "TODO",
        "FIXME"
    ],
    // clangd is the IntelliSense engine. Its compile_commands.json is written at the workspace
    // root by tools/ide/refresh_compile_commands.py (task "Bazel: refresh compile_commands.json").
    //
    // --compile-commands-dir rather than clangd's search up from each file: that search never
    // reaches the vendored trees, which live in Bazel's output base, and the database has
    // entries for them too.
    //
    // --query-driver lets clangd ask the compiler in the database -- the Arm toolchain Bazel
    // fetched, at an absolute path under the output base -- for its target and newlib's
    // headers. Without it every board file is parsed as x86.
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--query-driver=**/arm-none-eabi-gcc,**/arm-none-eabi-g++",
        "--function-arg-placeholders=false",
        "--clang-tidy",
        "--header-insertion=never"
    ],
    "editor.wordBasedSuggestions": "off"
}
