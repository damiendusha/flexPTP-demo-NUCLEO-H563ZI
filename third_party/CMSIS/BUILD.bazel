# ARM's CMSIS headers and ST's device headers. Header-only; there are no sources here.
#
# cmsis_os2.h is ARM's and RTOS-agnostic, which is what lets both a ThreadX-backed and a
# FreeRTOS-backed implementation sit underneath the same application code.
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "cmsis",
    hdrs = [
        "Device/ST/STM32H5xx/Include/stm32h563xx.h",
        "Device/ST/STM32H5xx/Include/stm32h5xx.h",
        "Device/ST/STM32H5xx/Include/system_stm32h5xx.h",
        "Include/cachel1_armv7.h",
        "Include/cmsis_armcc.h",
        "Include/cmsis_armclang.h",
        "Include/cmsis_armclang_ltm.h",
        "Include/cmsis_compiler.h",
        "Include/cmsis_gcc.h",
        "Include/cmsis_iccarm.h",
        "Include/cmsis_version.h",
        "Include/core_armv81mml.h",
        "Include/core_armv8mbl.h",
        "Include/core_armv8mml.h",
        "Include/core_cm0.h",
        "Include/core_cm0plus.h",
        "Include/core_cm1.h",
        "Include/core_cm23.h",
        "Include/core_cm3.h",
        "Include/core_cm33.h",
        "Include/core_cm35p.h",
        "Include/core_cm4.h",
        "Include/core_cm55.h",
        "Include/core_cm7.h",
        "Include/core_cm85.h",
        "Include/core_sc000.h",
        "Include/core_sc300.h",
        "Include/core_starmc1.h",
        "Include/mpu_armv7.h",
        "Include/mpu_armv8.h",
        "Include/pac_armv81.h",
        "Include/pmu_armv8.h",
        "Include/tz_context.h",
        "CMSIS_RTOS_V2/cmsis_os2.h",
        "CMSIS_RTOS_V2/freertos_mpool.h",
        "CMSIS_RTOS_V2/freertos_os2.h",
    ],
    includes = [
        "CMSIS_RTOS_V2",
        "Device/ST/STM32H5xx/Include",
        "Include",
    ],
    visibility = ["//visibility:public"],
)

# ST's FreeRTOS-backed CMSIS-RTOS2 implementation, from master.
#
# The counterpart of @cmsis_rtos_threadx: one cmsis_os2.h -- ARM's, RTOS-agnostic -- with two
# implementations underneath. That is what lets cli.c, cmds.c and serial_io.c be common to both
# projects, and it is why the monorepo is natural rather than forced.
#
# Exposed as SOURCES, not a library: it needs CMSIS_device_header and the device selection, which
# are the consuming project's to supply. //projects/flexptp_demo_stm32h563/flexptp_freertos_lwip_demo:cmsis_rtos builds
# it.
exports_files([
    "CMSIS_RTOS_V2/cmsis_os2_freertos.c",
    "CMSIS_RTOS_V2/freertos_os2.h",
    "CMSIS_RTOS_V2/freertos_mpool.h",
])
