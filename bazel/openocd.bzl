"""Locate an OpenOCD that can program an STM32H5.

ST's fork is required and there is no way around it: upstream OpenOCD has no compiled-in
`stm32h5x` flash driver, so `target/stm32h5x.cfg`'s `flash bank ... stm32h5x` declaration is
rejected, and copying ST's .cfg files onto a distro build does not help. ST publishes no
standalone binary of the fork either -- it ships inside CubeIDE/CubeCLT -- so there is nothing to
http_archive.

This repository rule finds a local one. It probes, in order:

    $OPENOCD                                  an explicit override
    toolchains/openocd/bin/openocd            what build.sh --with-openocd produces
    openocd on PATH

and then VERIFIES it is ST's fork rather than merely present, by matching "STMicroelectronics"
in `openocd --version`:

    Open On-Chip Debugger 0.12.0+dev-g49ef1d0 (...) [https://github.com/STMicroelectronics/OpenOCD]

That check is a new safeguard, not a port of an existing one. Today, pointing the build at a
distro OpenOCD gets a confusing failure at flash time, when it rejects a flash bank declaration
in a .cfg file. Checking at fetch time turns it into one message naming the fix.

The search order is deliberately the same one tools/hil/hil.py uses, so the two cannot disagree
about which binary is in play.
"""

_NOT_FOUND = """No OpenOCD found that can program an STM32H5.

Looked at, in order:
  $OPENOCD
  toolchains/openocd/bin/openocd
  openocd on PATH
{detail}
An STM32H5 needs ST's fork: upstream has no compiled-in stm32h5x flash driver. Build it with

    ./build.sh --with-openocd

or set OPENOCD to one you already have."""

def _probe(repository_ctx, path):
    """Return path if it exists and reports itself as ST's fork, else None."""
    if not path:
        return None
    p = repository_ctx.path(path)
    if not p.exists:
        return None
    res = repository_ctx.execute([str(p), "--version"], timeout = 20)
    banner = res.stdout + res.stderr
    if "STMicroelectronics" not in banner:
        return None
    return p

def _openocd_impl(repository_ctx):
    tried = []
    found = None

    env = repository_ctx.os.environ.get("OPENOCD", "")
    for candidate in [env, str(repository_ctx.workspace_root) + "/toolchains/openocd/bin/openocd"]:
        if candidate:
            tried.append(candidate)
            found = _probe(repository_ctx, candidate)
            if found:
                break

    if not found:
        on_path = repository_ctx.which("openocd")
        if on_path:
            tried.append(str(on_path))
            found = _probe(repository_ctx, on_path)

    if not found:
        detail = "\nChecked: " + ", ".join(tried) + "\n" if tried else ""
        fail(_NOT_FOUND.format(detail = detail))

    # The scripts directory sits at ../share/openocd/scripts relative to bin/openocd, and holds
    # board/st_nucleo_h5.cfg among others.
    scripts = found.dirname.dirname.get_child("share").get_child("openocd").get_child("scripts")

    repository_ctx.symlink(found, "openocd")
    if scripts.exists:
        repository_ctx.symlink(scripts, "scripts")
    else:
        repository_ctx.file("scripts/.empty", "")

    repository_ctx.file("BUILD.bazel", """# Generated by //bazel:openocd.bzl.
package(default_visibility = ["//visibility:public"])

exports_files(["openocd"])

filegroup(
    name = "binary",
    srcs = ["openocd"],
)

filegroup(
    name = "scripts",
    srcs = glob(["scripts/**"], allow_empty = True),
)
""")

_openocd_repository = repository_rule(
    implementation = _openocd_impl,
    configure = True,
    environ = ["OPENOCD", "PATH"],
    local = True,
)

def _openocd_ext_impl(_mctx):
    _openocd_repository(name = "openocd")

openocd = module_extension(implementation = _openocd_ext_impl)
