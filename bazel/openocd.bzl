"""Locate an OpenOCD that can program an STM32H5.

ST's fork is required and there is no way around it: upstream OpenOCD has no compiled-in
`stm32h5x` flash driver, so `target/stm32h5x.cfg`'s `flash bank ... stm32h5x` declaration is
rejected, and copying ST's .cfg files onto a distro build does not help. ST publishes no
standalone binary of the fork either -- it ships inside CubeIDE/CubeCLT -- so there is nothing to
http_archive.

This repository rule finds a local one. It probes, in order:

    $OPENOCD                                  an explicit override
    toolchains/openocd/bin/openocd            Bazel's source build, copied out (README.md, "Flashing")
    openocd on PATH

and then VERIFIES it is ST's fork rather than merely present, by matching "STMicroelectronics"
in `openocd --version`:

    Open On-Chip Debugger 0.12.0+dev-g49ef1d0 (...) [https://github.com/STMicroelectronics/OpenOCD]

That check is a new safeguard, not a port of an existing one. Today, pointing the build at a
distro OpenOCD gets a confusing failure at flash time, when it rejects a flash bank declaration
in a .cfg file. Checking at fetch time turns it into one message naming the fix.

The search order is deliberately the same one tools/hil/hil.py uses, so the two cannot disagree
about which binary is in play.
"""

load("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

_NOT_FOUND = """No OpenOCD found that can program an STM32H5.

Looked at, in order:
  $OPENOCD
  toolchains/openocd/bin/openocd
  openocd on PATH
{detail}
An STM32H5 needs ST's fork: upstream has no compiled-in stm32h5x flash driver. Either drop
--//tools/flash:openocd=local and let Bazel build the fork from source (the default), or build
it once and copy it to where local mode looks, from the repository root:

    bazel build --//tools/flash:openocd=source //tools/flash:openocd_binary
    rm -rf toolchains/openocd
    mkdir -p toolchains
    cp -rL --no-preserve=mode bazel-bin/external/+openocd+openocd_src/openocd_build toolchains/openocd
    chmod +x toolchains/openocd/bin/openocd

or set OPENOCD to one you already have."""

def _probe(repository_ctx, path):
    """Return path if it exists and reports itself as ST's fork, else None."""
    if not path:
        return None
    p = repository_ctx.path(path)
    if not p.exists:
        return None
    res = repository_ctx.execute([str(p), "--version"], timeout = 20)
    banner = res.stdout + res.stderr
    if "STMicroelectronics" not in banner:
        return None
    return p

def _openocd_impl(repository_ctx):
    tried = []
    found = None

    env = repository_ctx.os.environ.get("OPENOCD", "")
    for candidate in [env, str(repository_ctx.workspace_root) + "/toolchains/openocd/bin/openocd"]:
        if candidate:
            tried.append(candidate)
            found = _probe(repository_ctx, candidate)
            if found:
                break

    if not found:
        on_path = repository_ctx.which("openocd")
        if on_path:
            tried.append(str(on_path))
            found = _probe(repository_ctx, on_path)

    if not found:
        detail = "\nChecked: " + ", ".join(tried) + "\n" if tried else ""
        fail(_NOT_FOUND.format(detail = detail))

    # The scripts directory sits at ../share/openocd/scripts relative to bin/openocd, and holds
    # board/st_nucleo_h5.cfg among others.
    scripts = found.dirname.dirname.get_child("share").get_child("openocd").get_child("scripts")

    repository_ctx.symlink(found, "openocd")
    if scripts.exists:
        repository_ctx.symlink(scripts, "scripts")
    else:
        repository_ctx.file("scripts/.empty", "")

    repository_ctx.file("BUILD.bazel", """# Generated by //bazel:openocd.bzl.
package(default_visibility = ["//visibility:public"])

exports_files(["openocd"])

filegroup(
    name = "binary",
    srcs = ["openocd"],
)

filegroup(
    name = "scripts",
    srcs = glob(["scripts/**"], allow_empty = True),
)
""")

_openocd_repository = repository_rule(
    implementation = _openocd_impl,
    configure = True,
    environ = ["OPENOCD", "PATH"],
    local = True,
)

# ST's fork, built from source. The pin is the commit tag openocd-cubeide-v2.1.0 resolves to, and
# a COMMIT rather than imu's `branch = "openocd-cubeide-r7"`, because a branch moves and a pin
# should not. It is also what local mode finds in toolchains/openocd: README.md's "Flashing"
# section populates that directory by copying this build out of bazel-bin.
#
# init_submodules + "nosubmodule" is the important pair: ./bootstrap normally git-clones jimtcl
# and libjaylink, which would be a network fetch inside a build action. Fetching them
# declaratively during the repository fetch keeps that cached and content-addressed.
_OPENOCD_BUILD = """
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"], allow_empty = True),
    visibility = ["//visibility:public"],
)

configure_make(
    name = "openocd_build",
    autogen = True,
    autogen_command = "./bootstrap",
    autogen_options = ["nosubmodule"],
    configure_in_place = True,
    configure_options = [
        "--enable-stlink",
        "--disable-werror",
        # Everything this board needs is ST-Link over libusb. The adapters below want libftdi
        # and hidapi, which are frequently absent, and letting configure decide silently
        # produces a differently-capable binary depending on the host -- which is exactly what
        # //tools/flash:openocd_capability_test exists to catch. Disabling them explicitly makes
        # the result the same everywhere instead.
        "--disable-ftdi",
        "--disable-cmsis-dap",
        "--disable-jlink",
    ],
    lib_source = ":all_srcs",
    out_binaries = ["openocd"],
    out_data_dirs = ["share"],
    targets = [
        "",
        "install",
    ],
    visibility = ["//visibility:public"],
)

# configure_make produces bin/, include/ and share/; this picks out the binary alone, which is
# what a $(location) in a test or a flash rule needs.
filegroup(
    name = "openocd",
    srcs = [":openocd_build"],
    output_group = "openocd",
    visibility = ["//visibility:public"],
)

# The scripts tree (board/*.cfg and friends), installed under share/openocd/scripts.
filegroup(
    name = "scripts",
    srcs = [":openocd_build"],
    output_group = "gen_dir",
    visibility = ["//visibility:public"],
)
"""

def _openocd_ext_impl(_mctx):
    _openocd_repository(name = "openocd")
    new_git_repository(
        name = "openocd_src",
        build_file_content = _OPENOCD_BUILD,
        commit = "49ef1d0107909045e31a728406fcfaeb6f1d5946",  # tag openocd-cubeide-v2.1.0
        init_submodules = True,
        remote = "https://github.com/STMicroelectronics/OpenOCD.git",
    )

openocd = module_extension(implementation = _openocd_ext_impl)
