# The FreeRTOS project's host tests.
#
# Currently only the context rules (D15). The pure-logic tiers are identical to the ThreadX
# project's and are not duplicated here -- they test files the seeding check already asserts are
# byte-identical, so running them twice would prove the same thing twice. Phase 9 unifies those
# files and their tests together.
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The firmware's FreeRTOSConfig.h is written for the Cortex-M33 -- interrupt priorities, a heap
# sized for the board. The POSIX port needs neither, and inherits only the settings that ARE
# kernel behaviour. Same split, same reasoning, as the ThreadX project's host byte-pool sizes.
cc_library(
    name = "freertos_config_host",
    hdrs = ["host/FreeRTOSConfig.h"],
    includes = ["host"],
    visibility = ["//projects/flexptp_freertos_lwip_demo:__pkg__"],
)

cc_library(
    name = "host_shims",
    hdrs = glob(["host/*.h"]),
    includes = ["host"],
)

# ST's FreeRTOS-backed CMSIS-RTOS2 wrapper over the POSIX port, with the host's larger pools.
# The rule these tests pin lives in the wrapper and in the kernel's common sources, so a host
# build enforces it the same way the target does -- which is what makes this testable at all.
cc_library(
    name = "host_cmsis_rtos",
    srcs = [
        "host/cmsis_host_device.c",
        "host/host_support.c",
        "//third_party/CMSIS:CMSIS_RTOS_V2/cmsis_os2_freertos.c",
    ],
    hdrs = [
        "//third_party/CMSIS:CMSIS_RTOS_V2/freertos_mpool.h",
        "//third_party/CMSIS:CMSIS_RTOS_V2/freertos_os2.h",
    ],
    copts = [
        "-w",
        # host/ FIRST: its cmsis_compiler.h shadows ARM's, whose __get_IPSR() emits
        # `mrs r0, ipsr` -- an instruction x86 cannot assemble.
        "-Iprojects/flexptp_freertos_lwip_demo/test/host",
    ],
    defines = [
        r'CMSIS_device_header=\"cmsis_host_device.h\"',
        # ST's cmsis_os2.c hard-includes "stm32h5xx.h" -- not through CMSIS_device_header, so
        # the indirection above does not cover it. The device header is therefore the REAL one,
        # with host/ shadowing core_cm33.h: the same arrangement the ThreadX project uses, and
        # for the same reason -- the definitions under test should be the ones the firmware
        # compiles against.
        "STM32H563xx",
    ],
    linkstatic = True,
    strip_include_prefix = "/third_party/CMSIS/CMSIS_RTOS_V2",
    deps = [
        ":freertos_config_host",
        ":host_shims",
        "//third_party/CMSIS:cmsis",
        "@freertos//:freertos_posix",
    ],
)

cc_test(
    name = "test_rtos_context",
    size = "medium",
    srcs = ["test_rtos_context.cpp"],
    copts = ["-Iprojects/flexptp_freertos_lwip_demo/test/host"],
    deps = [
        ":host_cmsis_rtos",
        "@googletest//:gtest",
    ],
)
