# The ThreadX + NetX Duo firmware.
#
# Phase 2 defines only the configuration headers -- the seam the vendored libraries reach this
# project through. The libraries and the binary arrive in phases 3 and 4.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:flexptp.bzl", "flexptp_library")
load("//tools/build_rules:firmware.bzl", "stm32_firmware")
load("//tools/flash:flash.bzl", "stm32_flash_binary")

package(default_visibility = ["//visibility:public"])

# Each of these is the target a label_flag in the corresponding vendored BUILD file points at,
# so a second project can supply its own without forking the vendored file. With one project the
# indirection looks like ceremony around a constant; it is the seam phase 8 writes through.


cc_library(
    name = "tx_user",
    hdrs = ["tx_user.h"],
    includes = ["."],
)

cc_library(
    name = "nx_user",
    hdrs = ["nx_user.h"],
    includes = ["."],
)

# ---------------------------------------------------------------------------
# Project-wide compile settings
# ---------------------------------------------------------------------------
#
# compile_DEFS in CMakeLists.txt, minus the HAL device selection which rides on :hal_conf. Kept
# on one target that every first-party library depends on, rather than repeated.
cc_library(
    name = "project_defines",
    defines = [
        "CMSIS_OS2",
        "PPS_SIMPLE",
        "ETH_NETXDUO",
        r'ETH_STACK=\"NETXDUO\"',
        r'PROJECT_NAME=\"flexptp-demo\"',
    ],
)

# The include root and the project-wide defines. Deliberately carries NO headers: sources refer
# to each other as <cli/cli.h>, <eth/mac_drv.h>, <ptp/...>, and all this target has to do is put
# the project directory on the path.
#
# flexptp_options.h is NOT here. It includes cli/cli.h, standard_output/standard_output.h and
# eth/mac_drv.h, so putting it on the base target every library depends on would make :cli
# depend on itself. It gets its own target below, after the things it includes.
cc_library(
    name = "includes",
    includes = ["."],
    deps = [
        "//lib:hal_conf",
        ":project_defines",
    ],
)

FIRST_PARTY = ["first_party_warnings"]

TARGET_ONLY = ["//toolchain:stm32h563"]

# ---------------------------------------------------------------------------
# Libraries
# ---------------------------------------------------------------------------




# The pure-logic units, extracted from the driver so they can be tested off-target. They depend
# on nothing but stdint, which is the whole point -- and is why they are the first thing phase 9
# will unify between the two projects.


# mac_drv.c exposed for TEXTUAL inclusion, which is how test/mac_drv_uut.c reaches the driver's
# file statics -- it #includes the .c verbatim. textual_hdrs rather than srcs: compiling it here
# as well as in :mac_drv would be duplicate symbols.
exports_files(["blocking_io/blocking_fifo.c"])



# The stack-facing glue.
cc_library(
    name = "eth",
    srcs = [
        "eth/eth_drv_netxduo.c",
        "eth/ethernet_netxduo.c",
    ],
    hdrs = [
        "eth/eth_drv_netxduo.h",
        "eth/ethernet_netxduo.h",
    ],
    features = FIRST_PARTY,
    target_compatible_with = TARGET_ONLY,
    deps = [
        "//lib:eth_framer",
        "//lib:eth_link_state",
        ":includes",
        "//lib:mac_drv",
        ":ptp_tx_timestamp",
        "//lib:ptp_units",
        "//lib:standard_output",
        "@netxduo",
    ],
)

# The reset vector, and ThreadX's board-specific low-level init.
#
# tx_initialize_low_level.S is ours rather than the port's -- Eclipse keeps it in example_build/
# because the clock, tick, vector symbol and end-of-RAM marker are the integrator's to supply --
# and it reads TX_TIMER_TICKS_PER_SECOND out of tx_user.h, so it needs ThreadX's headers and the
# TX_INCLUDE_USER_DEFINE_FILE define that come with @threadx. Without them it #errors, which is
# the file doing its job.
cc_library(
    name = "startup",
    srcs = ["startup/tx_initialize_low_level.S"],
    target_compatible_with = TARGET_ONLY,
    deps = [
        ":includes",
        "@threadx",
    ],
    alwayslink = True,
)


# ---------------------------------------------------------------------------
# flexPTP: the pure units, the hardware port, and the assembled library
# ---------------------------------------------------------------------------

# The NSD logic lifted out of the driver so it could be tested off-target. Depends on nothing
# but stdint -- no ThreadX, no NetX Duo, no fakes -- which is why it builds for the host too and
# why it is first in phase 9's unification order.
#
# A library in its own right rather than sources compiled into flexPTP, because the Ethernet
# driver calls into it as well; compiling it in both places would be duplicate symbols.
# Header-only, and host-buildable: the bounds arithmetic _sbrk relies on, extracted so it can be
# tested without a target.


# The transmit-timestamp registry's target half. Kept out of :ptp_units because it needs
# CMSIS-RTOS2 and flexPTP's headers, and :ptp_units' whole value is that it needs neither -- it
# is the part the host suite can compile.
#
# This file exists because flexPTP's CMSIS-RTOS2 binding calls osMessageQueuePut(..., osWaitForever)
# from the transmit-timestamp callback, which on this hardware is reached from ETH_IRQHandler,
# and ST's wrapper refuses a blocking call from interrupt context.
cc_library(
    name = "ptp_tx_timestamp",
    srcs = ["ptp/ptp_tx_timestamp.c"],
    hdrs = ["ptp/ptp_tx_timestamp.h"],
    features = FIRST_PARTY,
    includes = ["."],
    target_compatible_with = TARGET_ONLY,
    deps = [
        ":flexptp_config",
        ":includes",
        "//lib:ptp_units",
        "//lib:standard_output",
        "@cmsis_rtos_threadx//:cmsis_rtos_tx",
        "@flexptp//:headers",
    ],
)

# flexPTP's configuration header, and the seam @flexptp reaches this project through.
#
# It is a configuration header that includes half the application -- the CLI, the console, the
# MAC driver and the hardware port -- which is why it sits at the bottom of the dependency order
# rather than on :includes with the other config headers.
cc_library(
    name = "flexptp_config",
    hdrs = [
        "flexptp_options.h",
        "//lib:ptp/ptp_port_stm32h563.h",
    ],
    features = FIRST_PARTY,
    includes = [
        ".",
        "ptp",
    ],
    target_compatible_with = TARGET_ONLY,
    deps = [
        "//lib:cli",
        ":includes",
        "//lib:mac_drv",
        "//lib:standard_output",
        "@embfmt",
        "@flexptp//:headers",
    ],
)

# ---------------------------------------------------------------------------
# flexPTP, and the firmware
# ---------------------------------------------------------------------------

# flexPTP with this project's hardware port and NSD compiled in, exactly as
# FLEXPTP_HWPORT_SRC and FLEXPTP_NSD_SRC do under CMake.
flexptp_library(
    name = "flexptp",
    config = ":flexptp_config",
    features = FIRST_PARTY,
    # The NSD and the port include their own headers unqualified, so ptp/ is on the path via
    # :flexptp_config.
    nsd_hdrs = ["ptp/nsd_netxduo.h"],
    nsd_srcs = ["ptp/nsd_netxduo.c"],
    port_srcs = ["//lib:ptp/ptp_port_stm32h563.c"],
    target_compatible_with = TARGET_ONLY,
    deps = [
        ":eth",
        ":includes",
        "//lib:mac_drv",
        ":ptp_tx_timestamp",
        "//lib:ptp_units",
        "//lib:standard_output",
        "@cmsis_rtos_threadx//:cmsis_rtos_tx",
        "@netxduo",
        "@stm32h5_hal//:hal",
    ],
)

# The application itself.
cc_library(
    name = "app",
    srcs = [
        "cmds.c",
        "main.c",
    ],
    hdrs = ["cmds.h"],
    features = FIRST_PARTY,
    target_compatible_with = TARGET_ONLY,
    deps = [
        "//lib:cli",
        ":eth",
        ":flexptp",
        ":flexptp_config",
        ":includes",
        "//lib:mac_drv",
        "//lib:standard_output",
        "@cmsis_rtos_threadx//:cmsis_rtos_tx",
        "@netxduo",
        "@stm32h5_hal//:hal",
    ],
    alwayslink = True,
)

# Visible to //tools/ci so the C++ rules can be asserted against the linked image.
stm32_firmware(
    name = "flexptp-demo",
    linker_script = "//lib:startup/stm32h563zitx_FLASH.ld",
    deps = [
        "//lib:runtime",
        "//lib:startup",
        ":app",
        ":startup",
    ],
)

# bazel run //projects/flexptp_threadx_netx_demo:flash
#
# The ELF is transitioned onto the target platform by the rule, so this cannot flash a host
# build -- which matters more once phase 8 puts a second image in the tree.
stm32_flash_binary(
    name = "flash",
    elf_image = ":flexptp-demo.elf",
)

# The ELF alone, through the firmware's platform transition, for host-side consumers.
filegroup(
    name = "flexptp-demo_elf",
    srcs = [":flexptp-demo"],
    output_group = "elf",
)

# Every source in this project, for //tools/ci:seeding_test to compare the two trees.
filegroup(
    name = "all_sources",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.s",
        "**/*.S",
        "**/*.ld",
    ], allow_empty = True),
)
