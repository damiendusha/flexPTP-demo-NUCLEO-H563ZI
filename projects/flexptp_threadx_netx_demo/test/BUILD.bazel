# The host test suite.
#
# Under CMake this is a SEPARATE project(), because the top-level CMakeLists.txt includes the ARM
# toolchain file unconditionally and there is no flag that makes it produce a host binary. In
# Bazel that separation disappears -- host and target are two platforms in one graph -- which is
# the "second configuration of the world" hazard test/CMakeLists.txt warns about, removed rather
# than managed.
#
# What each tier can and cannot prove is in the project's testing_architecture.md. A green run
# here says nothing about codegen defects or anything downstream of the timestamp capture.
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Tier 1 moved to //lib/test in phase 9, with the code it tests.


# ---------------------------------------------------------------------------
# Tier 2 -- the MAC driver against a software DMA model
# ---------------------------------------------------------------------------
#
# Two constraints carried over from CMake, both load-bearing:
#
#   INCLUDE ORDER. host/ must come FIRST so its core_cm33.h, system_stm32h5xx.h and
#   cmsis_compiler.h shadow ARM's. ARM's cmsis_gcc.h emits `mrs r0, ipsr` for __get_IPSR(),
#   which x86 cannot assemble. Everything below the shim is the REAL thing -- ST's CMSIS device
#   header and ST's HAL headers -- so the register layouts under test are the same definitions
#   the firmware compiles against, following the pinned HAL automatically. Nothing is
#   hand-copied. Bazel offers no direct control over include order across deps, so the shim
#   directory is forced ahead with an explicit -I in copts rather than left to `includes`.
#
#   -no-pie / -fno-pie. The driver casts pointers to uint32_t because on the target they are 32
#   bits; -no-pie puts .text low enough that a function pointer still fits in the uint32_t
#   ETHHW_DescExt.tsCbPtr field. Without it the transmit-timestamp callback truncates and the
#   first dispatch jumps into nowhere. Applies to the test binaries too, not just the library.
cc_library(
    name = "host_shims",
    hdrs = glob(["host/*.h"]),
    includes = ["host"],
)

cc_library(
    name = "host_mac_drv",
    srcs = [
        "host/host_arena.c",
        "host/host_mmio.c",
        "mac_drv_uut.c",
    ],
    hdrs = [
        "host/host_arena.h",
        "host/host_mmio.h",
    ],
    copts = [
        "-Iprojects/flexptp_threadx_netx_demo/test/host",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        # The pointer/int casts are deliberate and handled by keeping every such object in the
        # MAP_32BIT arena; warning about them here says nothing useful.
        "-Wno-pointer-to-int-cast",
        "-Wno-int-to-pointer-cast",
        "-fno-pie",
    ],
    defines = [
        "STM32H563xx",
        "USE_HAL_DRIVER",
    ],
    includes = ["."],
    linkopts = ["-no-pie"],
    # No shared object: -no-pie and a .so are contradictory, and Bazel builds one for a
    # cc_library by default.
    linkstatic = True,
    deps = [
        ":host_shims",
        "//projects/flexptp_threadx_netx_demo:hal_conf",
        "//projects/flexptp_threadx_netx_demo:mac_drv_textual",
        "//third_party/CMSIS:cmsis",
        "@stm32h5_hal//:hal_headers",
    ],
)

cc_library(
    name = "eth_model",
    srcs = ["eth_model.cpp"],
    hdrs = ["eth_model.hpp"],
    copts = ["-Iprojects/flexptp_threadx_netx_demo/test/host"],
    includes = ["."],
    linkstatic = True,
    deps = [":host_mac_drv"],
)

[
    cc_test(
        name = name,
        size = "small",
        srcs = ["%s.cpp" % name],
        copts = ["-Iprojects/flexptp_threadx_netx_demo/test/host"],
        linkopts = ["-no-pie"],
        deps = [
            ":eth_model",
            "@googletest//:gtest_main",
        ],
    )
    for name in [
        "test_host_harness",
        "test_rx_ring",
        "test_tx_ring",
    ]
]

# ---------------------------------------------------------------------------
# Tier 3 -- real ThreadX on the host, for the context rules
# ---------------------------------------------------------------------------
#
# The one class of defect this port kept getting wrong is "a blocking call from a context that
# may not block" -- three times, all in flexPTP's CMSIS-RTOS2 binding. None of it needs NetX Duo
# or a PTP exchange; it needs REAL ThreadX, because the restriction lives in
# common/src/txe_queue_send.c, which the Linux port shares with the Cortex-M33 one.
#
# The byte-pool sizes deliberately DIFFER from the firmware's. tx_user.h is shared so the kernel
# behaves identically, but these are not kernel behaviour -- they are how much RAM the wrapper
# is given, and the host runs GoogleTest rather than a 2 KB CLI thread. Sizing them like the
# board's 24 KB just makes osThreadNew() fail at startup.
cc_library(
    name = "host_cmsis_rtos",
    srcs = ["@cmsis_rtos_threadx//:cmsis_os2_src"],
    copts = [
        "-w",
        # host/ FIRST: its cmsis_compiler.h shadows ARM's, whose __get_IPSR() emits
        # `mrs r0, ipsr` -- an instruction x86 cannot assemble.
        "-Iprojects/flexptp_threadx_netx_demo/test/host",
    ],
    defines = [
        "USE_DYNAMIC_MEMORY_ALLOCATION",
        "RTOS2_BYTE_POOL_STACK_SIZE=1048576",
        "RTOS2_BYTE_POOL_HEAP_SIZE=262144",
    ],
    linkstatic = True,
    deps = [
        ":host_shims",
        "//third_party/CMSIS:cmsis",
        "@threadx//:threadx_linux",
    ],
)

# Not size = "small": these enter a kernel that never returns until the test ends, and spawn
# real pthreads.
cc_test(
    name = "test_rtos_context",
    size = "medium",
    srcs = ["test_rtos_context.cpp"],
    copts = ["-Iprojects/flexptp_threadx_netx_demo/test/host"],
    deps = [
        ":host_cmsis_rtos",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "test_blocking_fifo",
    size = "medium",
    srcs = [
        "test_blocking_fifo.cpp",
        "//projects/flexptp_threadx_netx_demo:blocking_io/blocking_fifo.c",
    ],
    copts = ["-Iprojects/flexptp_threadx_netx_demo/test/host"],
    deps = [
        ":host_cmsis_rtos",
        "//projects/flexptp_threadx_netx_demo:blocking_io_headers",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "test_cli",
    size = "medium",
    srcs = [
        "cli_uut.c",
        "test_cli.cpp",
        "//projects/flexptp_threadx_netx_demo:blocking_io/blocking_fifo.c",
    ],
    copts = [
        "-Iprojects/flexptp_threadx_netx_demo/test/host",
        "-Wno-unused-parameter",
    ],
    deps = [
        ":host_cmsis_rtos",
        "//projects/flexptp_threadx_netx_demo:blocking_io_headers",
        "//projects/flexptp_threadx_netx_demo:cli_textual",
        "@googletest//:gtest",
    ],
)
