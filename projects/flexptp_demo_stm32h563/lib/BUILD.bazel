# The bounds arithmetic _sbrk relies on. Header-only.
cc_library(
    name = "sysmem_bounds",
    hdrs = ["runtime/sysmem_bounds.h"],
    features = FIRST_PARTY,
    includes = ["runtime"],
)

cc_test(
    name = "sysmem_bounds_test",
    size = "small",
    srcs = ["runtime/sysmem_bounds_test.cpp"],
    deps = [
        ":sysmem_bounds",
        "@googletest//:gtest_main",
