# Code common to both firmwares.
#
# Phase 9 of the Bazel migration (D11): the two projects were kept deliberately independent
# while the second was brought up, and what is genuinely shared is factored out afterwards --
# against two real applications rather than against a guess about what one of them would need.
#
# This is tier 1 of the order in docs/bazel_migration.md §13.8: units that depend on nothing but
# stdint. They were extracted from the driver in the first place so they could be tested
# off-target, which is also what makes them the safest thing to unify -- the host suite already
# pins their behaviour, and //tools/ci:seeding_test had been asserting the two projects' copies
# were byte-identical, so there is nothing to reconcile.
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

FIRST_PARTY = [
    "first_party_analysis",
    "first_party_warnings",
]

# GCC's -fanalyzer -- interprocedural double-free, use-after-free, NULL dereference, leak and
# uninitialised-read checking -- on the HOST build of first-party code (finding GI-03). The host
# is the one place this code meets the system compiler, so it costs nothing extra to ask.
#
# Host only, and for a reason beyond speed: the units below are also compiled into both
# firmwares, where first_party_warnings carries -Werror, and an analyzer false positive must not
# be able to break a firmware build. On the host it stays a warning, deliberately -- a checker
# that blocks the suite on a false positive is a checker somebody disables. Bazel prints it only
# from the compile that produces it, so a new finding shows in the run that introduces it.
#
# Never on the GoogleTest files. Analysing one is 20 s to nearly 3 minutes -- spent in gtest and
# the standard library, not in our code -- against under 2 s for any unit here.
HOST_ANALYZER = select({
    "//toolchain:is_cortex_m33": [],
    "//conditions:default": ["-fanalyzer"],
})

# The flexPTP network-stack-driver logic, lifted out of the NSD so it could be tested without a
# board, an RTOS or a network stack.
cc_library(
    name = "ptp_units",
    srcs = [
        "ptp/ptp_endpoint.cpp",
        "ptp/ptp_nsd_lifecycle.cpp",
        "ptp/ptp_ts_codec.cpp",
        "ptp/ptp_tx_registry.cpp",
    ],
    # ptp_port_stm32h563.h is here but its .c is NOT: the port is compiled per-project
    # (see :ptp_port_srcs below), while its header is part of this library's interface.
    hdrs = [
        "ptp/ptp_endpoint.h",
        "ptp/ptp_nsd_lifecycle.h",
        "ptp/ptp_port_stm32h563.h",
        "ptp/ptp_ts_codec.h",
        "ptp/ptp_tx_registry.h",
    ],
    copts = HOST_ANALYZER,
    features = FIRST_PARTY,
    includes = [
        ".",
        "ptp",
    ],
)

# The unit tests, kept beside the code they test, so a unit and its test move together and
# neither can be found without the other.
#
# Tests and sources share the .cpp extension, so only the _test suffix separates them. That is
# safe because every srcs list in this file is explicit -- but it means a glob like
# glob(["ptp/*.cpp"]) reintroduced here would silently compile the tests INTO the library they
# cover, linking GoogleTest into the firmware. List the files.
cc_test(
    name = "ptp_endpoint_test",
    size = "small",
    srcs = ["ptp/ptp_endpoint_test.cpp"],
    deps = [
        ":ptp_units",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "ptp_nsd_lifecycle_test",
    size = "small",
    srcs = ["ptp/ptp_nsd_lifecycle_test.cpp"],
    deps = [
        ":ptp_units",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "ptp_ts_codec_test",
    size = "small",
    srcs = ["ptp/ptp_ts_codec_test.cpp"],
    deps = [
        ":ptp_units",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "ptp_tx_registry_test",
    size = "small",
    srcs = ["ptp/ptp_tx_registry_test.cpp"],
    deps = [
        ":ptp_units",
        "@googletest//:gtest_main",
    ],
)

