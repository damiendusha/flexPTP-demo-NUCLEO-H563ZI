# The arm-none-eabi toolchain for the STM32H563, and the platform it targets.
#
# No Pigweed. The flags below are the ones the CMake build uses, and the reasoning behind the
# non-obvious ones is preserved in place rather than being left to git history -- see in
# particular the optimisation levels, where -O2 is a deliberate change from CMake's -Og
# (decision D8 in docs/bazel_decisions.md).

load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@rules_cc//cc/toolchains:tool.bzl", "cc_tool")
load("@rules_cc//cc/toolchains:tool_map.bzl", "cc_tool_map")
load("@rules_cc//cc/toolchains:toolchain.bzl", "cc_toolchain")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Constraints and the platform
# ---------------------------------------------------------------------------
#
# @platforms//cpu:armv8-m cannot tell a Cortex-M33 from a Cortex-M23, and says nothing about the
# FPU -- yet -mfpu=fpv5-sp-d16 -mfloat-abi=hard are baked into this toolchain. A second Armv8-M
# part added later would match it and be compiled with the wrong FPU flags, silently. Four lines
# make that impossible.
#
# The constraint also earns its keep on first-party libraries, which carry
# target_compatible_with = ["//toolchain:stm32h563"]: that is what lets a single
# `bazel build //...` skip the firmware on the host rather than trying to compile mac_drv.c for
# x86 and failing.
constraint_setting(name = "mcu")

constraint_value(
    name = "stm32h563",
    constraint_setting = ":mcu",
)

platform(
    name = "cortex_m33",
    constraint_values = [
        "@platforms//cpu:armv8-m",
        "@platforms//os:none",
        ":stm32h563",
    ],
)

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------

[
    cc_tool(
        name = "arm-none-eabi-%s" % tool,
        src = "@arm_gnu_toolchain//:bin/arm-none-eabi-%s" % tool,
        data = ["@arm_gnu_toolchain//:compiler_support"],
    )
    for tool in [
        "gcc",
        "g++",
        "ar",
        "ld",
        "objcopy",
        "objdump",
        "strip",
        "nm",
        "readelf",
        "size",
    ]
]

cc_tool_map(
    name = "all_tools",
    tools = {
        "@rules_cc//cc/toolchains/actions:assembly_actions": ":arm-none-eabi-gcc",
        "@rules_cc//cc/toolchains/actions:c_compile_actions": ":arm-none-eabi-gcc",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions": ":arm-none-eabi-g++",
        "@rules_cc//cc/toolchains/actions:link_actions": ":arm-none-eabi-gcc",
        "@rules_cc//cc/toolchains/actions:objcopy_embed_data": ":arm-none-eabi-objcopy",
        "@rules_cc//cc/toolchains/actions:strip": ":arm-none-eabi-strip",
        "@rules_cc//cc/toolchains/actions:ar_actions": ":arm-none-eabi-ar",
    },
)

# ---------------------------------------------------------------------------
# Flags
# ---------------------------------------------------------------------------

# cpu_PARAMS in CMakeLists.txt. On compile AND link: the float ABI has to match at both ends or
# the link picks the wrong multilib (thumb/v8-m.main+fp/hard).
cc_args(
    name = "cpu_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:assembly_actions",
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-mthumb",
        "-mcpu=cortex-m33",
        "-mfpu=fpv5-sp-d16",
        "-mfloat-abi=hard",
    ],
)

# The two -f flags that make section garbage collection possible. Their partner is
# -Wl,--gc-sections below; removing one without the other is finding H-3, which grew the Release
# image from 167 424 B to 233 924 B.
cc_args(
    name = "reduced_size",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fdata-sections",
        "-ffunction-sections",
    ],
)

cc_args(
    name = "no_canonical_prefixes",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-no-canonical-prefixes"],
)

# CPP_FLAGS in cmake/gcc-arm-none-eabi.cmake. Enforced against the linked image as well, by
# tools/ci/check_cxx_rules.sh -- these flags are why that check passes.
cc_args(
    name = "cpp_no_runtime",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_compile_actions"],
    args = [
        "-fno-rtti",
        "-fno-exceptions",
        "-fno-threadsafe-statics",
    ],
)

cc_args(
    name = "asm_with_cpp",
    actions = ["@rules_cc//cc/toolchains/actions:assembly_actions"],
    args = ["-x", "assembler-with-cpp"],
)

# target_link_options in CMakeLists.txt.
cc_args(
    name = "link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "--specs=nosys.specs",
        "-Wl,--gc-sections",
        # Allow good software remapping across address space.
        "-Wl,-z,max-page-size=8",
        # A SHA-1 over the linked output, in .note.gnu.build-id. `osinfo` prints it and
        # tools/hil/ compares it against the ELF, so the hardware suite cannot report a pass
        # for an image it did not test (finding GI-01).
        "-Wl,--build-id=sha1",
        "-Wl,--print-memory-usage",
        # NOTE: --start-group -lc -lm -lstdc++ -lsupc++ --end-group is deliberately NOT here.
        #
        # cc_args on the toolchain are emitted BEFORE the object files. A library group in that
        # position is inert: the linker reads the archives with nothing yet unresolved, takes
        # nothing from them, and then meets the objects' undefined references with no archives
        # left to satisfy them. It looked correct and did nothing -- the giveaway was that
        # adding a std::vector failed at LINK with "undefined reference to operator delete"
        # instead of linking and being caught by tools/ci/check_cxx_rules.sh, which is how the
        # CMake build behaves.
        #
        # The group belongs in the firmware's linkopts, which are user link flags and are
        # emitted after the objects. See stm32_firmware() in tools/build_rules/firmware.bzl.
    ],
)

# Optimisation, per compilation mode. CMake Debug/Release map to dbg/opt.
#
# opt is -O2, which is a DELIBERATE CHANGE from CMake's -Og (D8). The CMakeLists comment records
# the measurements: -Og 149 400 B, -O2 149 456 B (+56 B), -Os 147 400 B, all three built and run
# on hardware with the full S8 suite passing. What -O2 gives up is debuggable release images;
# what it buys is `-c opt` meaning what a Bazel user expects.
#
# One consequence to be aware of: the F62 regression -- the H563's UID must be read 32 bits at a
# time -- was re-checked by disassembly at -Og only, because drv_initialize() is inlined away at
# -O2. See the note in CMakeLists.txt.
config_setting(
    name = "opt_mode",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "dbg_mode",
    values = {"compilation_mode": "dbg"},
)

cc_args(
    name = "optimisation",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        ":opt_mode": [
            "-O2",
            "-g0",
        ],
        # DEBUG is what makes a Debug image a Debug image, not the -O0: tx_user.h turns on
        # ThreadX's software stack check, nx_user.h keeps NetX Duo's API error checking and adds
        # per-packet owner tracking. CMake applied it as $<$<CONFIG:Debug>:DEBUG>; the migration
        # lost it, so until this line --config=dbg was fastbuild with more debug info. It is set
        # here, on every compile action, because nx_user.h's NX_ENABLE_PACKET_DEBUG_INFO changes
        # NX_PACKET's layout: the application and NetX Duo must see the same definition.
        ":dbg_mode": [
            "-O0",
            "-g3",
            "-ggdb",
            "-DDEBUG",
        ],
        "//conditions:default": [
            "-O0",
            "-g",
        ],
    }),
)

# -Wall -Wextra, applied to first-party targets only. Vendored trees keep -w, which is what
# keeps this gate meaningful: a warning in NetX Duo or the HAL is not this project's to fix.
#
# -Werror is on by default (D13). That is safe here in a way it usually is not, because the
# compiler is pinned by sha256 in MODULE.bazel: a new diagnostic can only arrive in the commit
# that bumps the toolchain, which is where it should be dealt with. Escape hatch, for bisecting
# or a half-finished refactor: --features=-first_party_warnings
cc_args(
    name = "first_party_warnings",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Werror",
    ],
)

# Declared in known_features on the toolchain below, which means OFF unless a target asks for
# it with features = ["first_party_warnings"].
cc_feature(
    name = "first_party_warnings_feature",
    args = [":first_party_warnings"],
    feature_name = "first_party_warnings",
)

cc_toolchain(
    name = "arm_none_eabi_cortex_m33",
    args = [
        ":cpu_flags",
        ":reduced_size",
        ":no_canonical_prefixes",
        ":cpp_no_runtime",
        ":asm_with_cpp",
        ":optimisation",
        ":link_flags",
    ],
    # Supplies the arguments Bazel's legacy action configs used to inject implicitly --
    # archiver flags, compile flags, include flags, the linker param file, and so on. Without
    # it the compile works and the ARCHIVE step fails, because `ar` is invoked with no
    # operation letters at all.
    enabled_features = ["@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features"],
    known_features = [
        ":first_party_warnings_feature",
        # Produces the .map alongside the ELF, using the link action's own output path. This is
        # what makes -Wl,-Map= expressible at all: a cc_binary cannot declare the extra output
        # and $(RULEDIR) is not available in linkopts.
        "@rules_cc//cc/toolchains/args/generate_linkmap:feature",
    ],
    tool_map = ":all_tools",
)

toolchain(
    name = "arm_none_eabi_cortex_m33_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//cpu:armv8-m",
        "@platforms//os:none",
        ":stm32h563",
    ],
    toolchain = ":arm_none_eabi_cortex_m33",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

# ---------------------------------------------------------------------------
# pkg-config, for the OpenOCD build
# ---------------------------------------------------------------------------
#
# rules_foreign_cc otherwise tries to BUILD pkg-config from source, which fails here at
# BootstrapPkgConfig. It ships preinstalled_* toolchains for cmake, ninja, make and meson but
# not for pkg-config, so this declares one over the host's.
#
# imu solves the same problem by taking pkg-config from BCR; using the host's avoids a
# dependency for a tool that is present on any machine able to build OpenOCD at all -- and
# OpenOCD's configure needs the host's libusb .pc files regardless, so this is not where
# hermeticity is won or lost. See docs/bazel_decisions.md §6, "The costs, stated honestly".
load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")

native_tool_toolchain(
    name = "host_pkgconfig",
    path = "pkg-config",
)

toolchain(
    name = "host_pkgconfig_toolchain",
    toolchain = ":host_pkgconfig",
    toolchain_type = "@rules_foreign_cc//toolchains:pkgconfig_toolchain",
)

# For select()ing on "is this the board?" -- the platform-driven half of the configuration
# question in docs/bazel_decisions.md §5.
config_setting(
    name = "is_cortex_m33",
    constraint_values = [":stm32h563"],
)
